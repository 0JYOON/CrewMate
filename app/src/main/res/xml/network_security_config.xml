<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: Disallow cleartext (HTTP) traffic globally across the entire app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Enforce HTTPS strictly for Korail Xcrew domain and subdomains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">xcrew.korail.com</domain>
        <domain includeSubdomains="true">korail.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext HTTP specifically for SubwayNowBot API bridge server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">129.225.156.25</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
